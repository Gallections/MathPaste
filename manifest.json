{
    "manifest_version": 3,
    "name": "Math Paste",
    "version": "2.0.0",
    "description": "Copy rendered math from ChatGPT, Claude, or Copilot and paste it as Obsidian, LaTeX, MathJax, Typst, Word, and more.",
    "permissions": [
        "scripting",
        "tabs",
        "webNavigation",
        "storage"
    ],
    "host_permissions": ["<all_urls>"],
    "icons": {
        "16": "icons/favicons/mathPaste-16x16.png",
        "48": "icons/favicons/mathPaste-48x48.png",
        "128": "icons/favicons/mathPaste-128x128.png"
    },
    "web_accessible_resources": [
        {
            "resources": ["icons/*", "onboarding.html"],
            "matches": ["<all_urls>"]
        }
    ],
    "background": {
        "service_worker": "src/background.ts"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/copy.ts", "src/frontend.ts"],
            "css": ["src/style.css"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_title": "Math Paste",
        "default_popup": "src/popup.html",
        "default_icon": {
            "16": "icons/favicons/mathPaste-16x16.png",
            "48": "icons/favicons/mathPaste-48x48.png",
            "128": "icons/favicons/mathPaste-128x128.png"
        }
    },
    "commands": {
        "toggle-math-paste": {
            "suggested_key": {
                "default": "Alt+Shift+M",
                "mac": "Alt+Shift+M"
            },
            "description": "Toggle math-paste on/off"
        }
    }
}
